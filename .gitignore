# ---- 源码阅读区 ----
# 克隆进来的开源项目自带 .git，由它们自己管理。
# 这里忽略 source/ 下的一切内容，只保留占位说明文件。
source/*
!source/README.md

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- Node / JS ----
node_modules/
dist/
build/

# ---- 密钥与环境 ----
.env
.env.*
*.local

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
